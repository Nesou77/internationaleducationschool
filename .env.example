# ─── Supabase ────────────────────────────────────────────────────────
# Fill these from your Supabase dashboard when you connect a project.
# For local dev or self-hosting, fill these from your Supabase dashboard:
#   Settings → API → Project URL  + Project API keys

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Optional: server-side (for edge functions / scripts) ────────────
# NEVER commit this — anyone with this key bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Third-party API keys (for edge functions) ───────────────────────
# Add anything your edge functions need to call:
# STRIPE_SECRET_KEY=
# OPENAI_API_KEY=
# RESEND_API_KEY=

# ─── Analytics ─────────────────────────────────────────────────────────
# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave empty to
# disable GTM — the script/noscript tags only render when this is set.
NEXT_PUBLIC_GTM_ID=
